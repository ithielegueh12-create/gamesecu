{
  "name": "piege-de-la-marina",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "voice:script": "esbuild scripts/export-voice-script.ts --bundle --platform=node --format=esm --outfile=voicegen/export-voice.mjs --log-level=warning && node voicegen/export-voice.mjs",
    "voice:build": "npm run voice:script && python3 voicegen/generate.py && python3 voicegen/qc.py"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  }
}